# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/parikshya?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_chars
ADMIN_SIGNUP_KEY=optional_secret_key_for_admin_registration

# Frontend CORS (comma-separated for multiple origins, e.g. https://your-app.vercel.app)
FRONTEND_ORIGIN=http://127.0.0.1:5173,https://your-frontend.vercel.app

# ImageKit (Optional - For image/profile/material uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Gemini API (Optional - For AI question generation)
GEMINI_API_KEY=your_gemini_api_key
